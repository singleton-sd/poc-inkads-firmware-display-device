#!/bin/sh

commit_msg_file="$1"

if [ -z "$commit_msg_file" ] || [ ! -f "$commit_msg_file" ]; then
  echo "commit-msg hook requires the commit message file path." >&2
  exit 1
fi

first_line=$(sed -n '1p' "$commit_msg_file" | tr -d '\r')

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9][a-z0-9._/-]*\))?!?: .+ \[[A-Z][A-Z0-9]+-[0-9]+\]$'

if printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'EOF'
Invalid commit message.

Expected format:
  <type>(optional-scope): <description> [ABC-123]

Examples:
  feat(ota): check the stable channel for updates [POC-247]
  fix(wifi): recover after disconnect [POC-247]

Allowed types:
  build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test
EOF

exit 1
