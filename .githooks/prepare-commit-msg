#!/bin/sh

commit_msg_file="$1"
commit_source="$2"
allowed_types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'

if [ -z "$commit_msg_file" ] || [ ! -f "$commit_msg_file" ]; then
  exit 0
fi

case "$commit_source" in
  merge|squash)
    exit 0
    ;;
esac

branch_name=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
branch_ticket=$(printf '%s\n' "$branch_name" | sed -nE 's#^(feature|hotfix)/([A-Z][A-Z0-9]+-[0-9]+)(-.+)?$#\2#p')

if [ -z "$branch_ticket" ]; then
  exit 0
fi

first_line=$(sed -n '1p' "$commit_msg_file" | tr -d '\r')

if printf '%s\n' "$first_line" | grep -Eq '\[[A-Z][A-Z0-9]+-[0-9]+\]$'; then
  exit 0
fi

if ! printf '%s\n' "$first_line" | grep -Eq "^(${allowed_types})(\\([a-z0-9][a-z0-9._/-]*\\))?!?: .+"; then
  exit 0
fi

tmp_file=$(mktemp)
awk -v ticket="$branch_ticket" '
  NR == 1 {
    sub(/\r$/, "", $0)
    print $0 " [" ticket "]"
    next
  }
  { print }
' "$commit_msg_file" > "$tmp_file"

mv "$tmp_file" "$commit_msg_file"
